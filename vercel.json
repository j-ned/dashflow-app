{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "angular",
      "installCommand": "pnpm install --frozen-lockfile --filter @dashflow/web",
      "buildCommand": "pnpm build",
      "ignoreCommand": "cd \"$(git rev-parse --show-toplevel)\" && B=\"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" && ! git diff --quiet \"$B\" HEAD && git diff --quiet \"$B\" HEAD -- . ':(exclude,glob)**/*.md' ':(exclude)docs' ':(exclude)apps/web/specs' ':(exclude)apps/api/docs' ':(exclude,glob)**/.claude/**' ':(exclude)apps/web/.superpowers' ':(exclude).github'",
      "outputDirectory": "dist/dash-flow/browser",
      "routes": [
        {
          "src": "^/(.*)$",
          "headers": {
            "Cache-Control": "no-cache",
            "Content-Security-Policy": "default-src 'self'; connect-src 'self' https://*.ingest.de.sentry.io; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'self'; frame-ancestors 'none'",
            "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()",
            "Referrer-Policy": "strict-origin-when-cross-origin",
            "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
            "X-Content-Type-Options": "nosniff",
            "X-Frame-Options": "DENY"
          },
          "continue": true
        },
        {
          "src": "^/(?:main|chunk|styles)-[a-zA-Z0-9_-]{8}\\.(?:js|css)$",
          "headers": {
            "Cache-Control": "public, max-age=31536000, immutable"
          },
          "continue": true
        },
        {
          "src": "^/media/.+$",
          "headers": {
            "Cache-Control": "public, max-age=31536000, immutable"
          },
          "continue": true
        },
        {
          "src": "^/(?:screen|icons)/.+$",
          "headers": {
            "Cache-Control": "public, max-age=86400"
          },
          "continue": true
        },
        {
          "src": "^/favicon\\.(?:ico|svg)$",
          "headers": {
            "Cache-Control": "public, max-age=86400"
          },
          "continue": true
        },
        {
          "handle": "filesystem"
        },
        {
          "src": "^/((?!.*\\.[a-zA-Z0-9]+$).*)$",
          "dest": "/index.html",
          "check": true
        },
        {
          "src": "^/(.*)$",
          "status": 404,
          "headers": {
            "Cache-Control": "no-cache"
          }
        }
      ]
    },
    "api": {
      "root": "./",
      "framework": "hono",
      "entrypoint": "apps/api/src/vercel.ts",
      "installCommand": "pnpm install --frozen-lockfile --filter @dashflow/api",
      "buildCommand": "pnpm --filter @dashflow/api exec tsc -p tsconfig.build.json --noEmit",
      "ignoreCommand": "cd \"$(git rev-parse --show-toplevel)\" && B=\"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" && ! git diff --quiet \"$B\" HEAD && git diff --quiet \"$B\" HEAD -- . ':(exclude,glob)**/*.md' ':(exclude)docs' ':(exclude)apps/web/specs' ':(exclude)apps/api/docs' ':(exclude,glob)**/.claude/**' ':(exclude)apps/web/.superpowers' ':(exclude).github'"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge-security-events",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/purge-unverified-accounts",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/reset-demo",
      "schedule": "0 3 * * *"
    }
  ]
}
