{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "angular",
      "installCommand": "pnpm install --frozen-lockfile --filter @dashflow/web",
      "buildCommand": "pnpm build",
      "ignoreCommand": "cd \"$(git rev-parse --show-toplevel)\" && B=\"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" && ! git diff --quiet \"$B\" HEAD && git diff --quiet \"$B\" HEAD -- . ':(exclude,glob)**/*.md' ':(exclude)docs' ':(exclude)apps/web/specs' ':(exclude)apps/api/docs' ':(exclude,glob)**/.claude/**' ':(exclude)apps/web/.superpowers' ':(exclude).github'",
      "outputDirectory": "dist/dash-flow/browser",
      "rewrites": [
        {
          "source": "/((?!.*\\.[a-zA-Z0-9]+$).*)",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            },
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; connect-src 'self' https://*.ingest.de.sentry.io; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'self'; frame-ancestors 'none'"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000; includeSubDomains"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            }
          ]
        },
        {
          "source": "/(main|chunk|styles)-([a-zA-Z0-9_-]{8})\\.(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/media/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/(screen|icons)/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "/favicon.(ico|svg)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ]
    },
    "api": {
      "root": "./",
      "framework": "hono",
      "entrypoint": "apps/api/src/vercel.ts",
      "installCommand": "pnpm install --frozen-lockfile --filter @dashflow/api",
      "buildCommand": "pnpm --filter @dashflow/api exec tsc -p tsconfig.build.json --noEmit",
      "ignoreCommand": "cd \"$(git rev-parse --show-toplevel)\" && B=\"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" && ! git diff --quiet \"$B\" HEAD && git diff --quiet \"$B\" HEAD -- . ':(exclude,glob)**/*.md' ':(exclude)docs' ':(exclude)apps/web/specs' ':(exclude)apps/api/docs' ':(exclude,glob)**/.claude/**' ':(exclude)apps/web/.superpowers' ':(exclude).github'"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/purge-security-events",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/purge-unverified-accounts",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/reset-demo",
      "schedule": "0 3 * * *"
    }
  ]
}
