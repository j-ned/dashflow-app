# Variables de production de la pile `deploy/compose.yaml`. Modèle sans secret : coller le contenu
# rempli dans l'onglet Environment du service Compose de Dokploy, qui l'écrit dans le `.env` voisin
# du compose. Le fichier rempli ne se versionne jamais et ne se colle ni dans une issue ni dans un
# journal de CI. Une variable facultative se laisse commentée.

# --- Postgres (service de base de données de Dokploy, hors de la pile) ------------------------------
# À recopier depuis la fiche du service `dashflow-db` dans Dokploy (Internal Credentials) : hôte
# interne, compte, base et mot de passe. Le mot de passe entre tel quel dans l'URL de connexion : un
# caractère comme @, : ou / la casse. Le choisir en hexadécimal (openssl rand -hex 32).
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PASSWORD=

# --- Redis (service de base de données de Dokploy, hors de la pile) ---------------------------------
# Compteurs de throttling partagés entre les instances de l'API. Depuis la fiche du service Redis
# dans Dokploy (Internal Credentials) : redis://default:<mot de passe>@<hôte interne>:6379
# Le mot de passe entre tel quel dans l'URL : le choisir en hexadécimal (openssl rand -hex 32).
REDIS_URL=

# --- API --------------------------------------------------------------------------------------------
# Origine du front (CSRF, retour OAuth, liens des mails) et adresse publique de l'API.
CORS_ORIGIN=https://dashflow.nedellec-julien.fr
APP_URL=https://dashflow.nedellec-julien.fr/api
# À conserver aussi hors du serveur (gestionnaire de mots de passe) :
# - TOTP_ENC_KEY chiffre les secrets de double authentification : une autre clé les rend illisibles.
# - JWT_SECRET signe les sessions : un nouveau déconnecte seulement tout le monde.
# TOTP_ENC_KEY fait 32 octets (64 caractères hexadécimaux) : l'API refuse de démarrer sinon.
JWT_SECRET=
TOTP_ENC_KEY=
# En-tête qui porte l'adresse du visiteur. Par défaut cf-connecting-ip (tunnel Cloudflare).
# CLIENT_IP_HEADER=

# Mail (API Resend) : clé d'API avec le droit « Sending access », limitée au domaine d'envoi.
# MAIL_FROM sur un domaine vérifié chez Resend (enregistrements SPF/DKIM posés dans Cloudflare).
RESEND_API_KEY=
MAIL_FROM=DashFlow <noreply@nedellec-julien.fr>

# Stockage des documents envoyés par les utilisateurs (ordonnances, documents, avatars).
S3_ENDPOINT=
# S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=

# Facultatives
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SENTRY_DSN=
# HEALTH_TOKEN=
# DEMO_ENABLED=false

# --- Sauvegardes de la base -------------------------------------------------------------------------
# Bucket privé, distinct de celui des documents, avec un jeton d'API limité à ce bucket.
# Pour R2 : https://<identifiant de compte>.r2.cloudflarestorage.com, sans `/` final
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
# openssl rand -base64 48 ; à conserver aussi hors du serveur (gestionnaire de mots de passe) :
# sans elle, aucune sauvegarde ne se déchiffre.
BACKUP_PASSPHRASE=

# --- Retour à une version (facultatif) --------------------------------------------------------------
# WEB_IMAGE=ghcr.io/j-ned/dashflow-web:sha-<commit>
# API_IMAGE=ghcr.io/j-ned/dashflow-api:sha-<commit>
